D G "BUF_SIZE" 8 46 "40" "tamanho dos Buffers do I2C1"
D G "PIC_ADDRESS" 8 47 "0xA0" "endereco da I2C1 do pic (modo slave) (em 8 bits=> o valor verdadeiro do endereco vai ser PIC_ADDRESS>>1 (endereco em 7 bits)"
D G "LED_PIN" 8 48 "PIN_A1" "pino onde está conectado o LED pino 12 RA1"
