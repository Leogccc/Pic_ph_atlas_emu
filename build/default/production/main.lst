03AE:  BSF    1E.2
03AF:  BTFSC  1E.2
03B0:  GOTO   3AF
....................  
....................      i2c_start(MCP3421_STREAM);  //send I2C start 
03B1:  BSF    1E.0
03B2:  BTFSC  1E.0
03B3:  GOTO   3B2
....................      i2c_write(MCP3421_STREAM, MCP3421_DEVICE_CODE | (address << 1) | 1);  //send read command 
03B4:  BCF    03.0
03B5:  MOVLB  03
03B6:  RLF    64,W
03B7:  IORLW  D0
03B8:  IORLW  01
03B9:  MOVWF  6A
03BA:  MOVWF  6B
03BB:  MOVLB  00
03BC:  CALL   071
....................  
....................     #if MCP3421_BITS == MCP3421_18BITS 
....................      result.b[2] = i2c_read(MCP3421_STREAM, 1);  //read MSB 18 Bit mode 
03BD:  MOVLW  01
03BE:  MOVWF  77
03BF:  CALL   2C3
03C0:  MOVF   78,W
03C1:  MOVLB  03
03C2:  MOVWF  67
....................     #endif 
....................      result.b[1] = i2c_read(MCP3421_STREAM, 1);  //read 2nd MSB 18 Bit mode, read MSB 16, 14 or 12 Bit mode 
03C3:  MOVLW  01
03C4:  MOVWF  77
03C5:  MOVLB  00
03C6:  CALL   2C3
03C7:  MOVF   78,W
03C8:  MOVLB  03
03C9:  MOVWF  66
....................      result.b[0] = i2c_read(MCP3421_STREAM, 1);  //read LSB 
03CA:  MOVLW  01
03CB:  MOVWF  77
03CC:  MOVLB  00
03CD:  CALL   2C3
03CE:  MOVF   78,W
03CF:  MOVLB  03
03D0:  MOVWF  65
....................    } 
....................  
....................    status = i2c_read(MCP3421_STREAM, 0);  //read Status, do nack 
03D1:  CLRF   77
03D2:  MOVLB  00
03D3:  CALL   2C3
03D4:  MOVF   78,W
03D5:  MOVLB  03
03D6:  MOVWF  69
....................    i2c_stop();  //send I2C stop 
03D7:  MOVLB  04
03D8:  BSF    1E.2
03D9:  BTFSC  1E.2
03DA:  GOTO   3D9
....................  
