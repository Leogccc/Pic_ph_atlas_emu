027A:  MOVF   51,W
027B:  MOVWF  7A
027C:  MOVF   50,W
027D:  MOVWF  04
027E:  MOVF   51,W
027F:  MOVWF  05
0280:  MOVF   00,W
0281:  MOVWF  54
0282:  MOVF   53,W
0283:  MOVWF  7A
0284:  MOVF   52,W
0285:  MOVWF  04
